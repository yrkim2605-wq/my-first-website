# 이 파일을 복사해서 `.env`를 만들고 값을 채워요 (`.env`는 git에 올라가지 않아요).
# 주의: 이 파일(env.example)에는 진짜 키를 절대 적지 않아요. 예시 문구만 둬요.

# 카카오 지도 JavaScript 키 (이미 쓰고 있어요)
VITE_KAKAO_JS_KEY=발급받은_JavaScript_키

# 저장 방식: local(기본, 이 브라우저에만 저장) | supabase(계정으로 저장 — 3단계부터 사용)
VITE_DATA_BACKEND=local

# Supabase 프로젝트 주소와 "공개 가능한" publishable 키 (Project Settings → API Keys)
# 비밀 키(sb_secret_…, service_role)는 여기에 절대 넣지 않아요. 브라우저에 그대로 노출돼요.
VITE_SUPABASE_URL=https://프로젝트ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# 데모 데이터(예시 게시글·순위)를 "데모" 표시와 함께 보여줄지 (기본 꺼짐)
VITE_DEMO_MODE=false

# ⚠️ 초안이에요. 이 파일도 "비공개" 백업 전용 저장소의 .github/workflows/cleanup-backups.yml 로 옮겨 쓸 거예요.
#
# 왜 필요한가: GitHub Artifact의 retention-days는 "만료일"만 정하고, 만료된 파일을 언제 실제로 지우는지는
#   공식 문서에 나와 있지 않아요 (다른 자료에서는 늦게 지워질 수 있다고 해요, 비공식). 그래서 자동 만료에만 맡기지 않고,
#   이 작업이 매일 오래된 백업을 직접 삭제해요 (공식 REST API의 삭제 기능, 삭제하면 복구할 수 없어요).
# 기준 (사용자 승인 2026-10-15): 21일을 넘긴 백업을 삭제 "시도"해요. 자동 만료는 25일(backup-db의 retention-days).
#   물리적으로 언제 완전히 지워지는지는 GitHub 내부 처리라서 보장하지 않아요. 삭제 요청이 처리되면 목록에서 사라지고 내려받을 수 없게 돼요(첫 실행 때 확인).
# 한계: 이 작업이 실패하면 지워지지 않아요 → README의 "주 1회 점검"에서 이 작업의 성공 여부도 봐요
#       (백업이 몇 주 연속 실패해도 오래된 백업은 방침대로 지워요. 그 결과 백업이 0개가 될 수 있어요 → 점검으로 막아요)

name: cleanup-backups

on:
  schedule:
    - cron: '30 18 * * *' # 매일 18:30 UTC = 03:30 KST
  workflow_dispatch:
    inputs:
      dry_run:
        description: 'true면 지우지 않고 대상만 세어요 (첫 시험용)'
        type: boolean
        default: true

permissions:
  actions: write # Artifact 삭제에 필요해요
  contents: read

concurrency:
  group: cleanup-backups
  cancel-in-progress: false

jobs:
  cleanup:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      GH_TOKEN: ${{ github.token }}
      MAX_AGE_DAYS: '21'
      DRY_RUN: ${{ inputs.dry_run || 'false' }} # 예약 실행에는 입력이 없어서 false(실제 삭제)가 돼요
    steps:
      - name: 오래된 백업 삭제
        run: |
          set -euo pipefail
          cutoff=$(date -u -d "-${MAX_AGE_DAYS} days" +%Y-%m-%dT%H:%M:%SZ)
          echo "기준 시각(이전에 만든 것은 삭제): ${cutoff}  /  dry_run=${DRY_RUN}"
          # 이미 만료 표시가 된 것도 포함해서, 기준보다 오래된 모든 Artifact의 번호만 가져와요
          ids=$(gh api --paginate "repos/${GITHUB_REPOSITORY}/actions/artifacts?per_page=100" \
            --jq ".artifacts[] | select(.created_at < \"${cutoff}\") | .id")
          if [ -z "${ids}" ]; then
            echo "삭제할 백업이 없어요"
            exit 0
          fi
          count=0
          for id in ${ids}; do
            if [ "${DRY_RUN}" = "true" ]; then
              echo "(dry-run) 삭제 대상 번호: ${id}"
            else
              gh api -X DELETE "repos/${GITHUB_REPOSITORY}/actions/artifacts/${id}" > /dev/null
              echo "삭제함: ${id}"
            fi
            count=$((count + 1))
          done
          echo "처리한 개수: ${count}"

      - name: 남은 것이 없는지 다시 확인 (실제 삭제일 때만)
        if: ${{ env.DRY_RUN != 'true' }}
        run: |
          set -euo pipefail
          cutoff=$(date -u -d "-${MAX_AGE_DAYS} days" +%Y-%m-%dT%H:%M:%SZ)
          left=$(gh api --paginate "repos/${GITHUB_REPOSITORY}/actions/artifacts?per_page=100" \
            --jq ".artifacts[] | select(.created_at < \"${cutoff}\") | .id" | wc -l)
          echo "기준보다 오래된 채로 남은 개수: ${left}"
          test "${left}" -eq 0 # 남아 있으면 이 작업이 실패 → GitHub 실패 알림 · 점검에서 발견돼요

# ⚠️ 초안이에요 (2차 개정). 이 파일은 "비공개" 백업 전용 저장소의 .github/workflows/backup-db.yml 로 옮겨 쓸 거예요.
#    이 공개 저장소(my-first-website)에는 절대 넣지 않아요. (설정 방법 · 한계: docs/backup/README.md)
#
# 하는 일: 매일 Supabase DB를 내보내서 → 암호화(키 2개로)하고 → Artifact로 올려요.
#   - public 스키마 전체 (앱 데이터)
#   - auth.users · auth.identities "데이터만" (가입 계정). 세션 · 토큰 · 감사 로그는 일부러 뺐어요
#   ※ 사진 파일(Storage)은 백업하지 않아요 (미구현). 자세한 내용은 README
# 보관 기간은 이중 장치예요 (사용자 승인 2026-10-15): ① cleanup-backups 가 매일 21일 넘은 것을 삭제 "시도" ② 아래 retention-days: 25 (GitHub 자동 만료 설정)
#   → GitHub가 삭제/만료된 파일을 내부에서 실제로 지우는 시점은 공식 문서에 없어서, 물리적 삭제 시점은 보장하지 않아요 (우리가 정하는 것은 삭제 시도와 만료 설정)

name: backup-db

on:
  schedule:
    - cron: '0 18 * * *' # 매일 18:00 UTC = 03:00 KST (cleanup-backups는 18:30 UTC에 돌아서 백업이 끝난 뒤에 정리해요)
  workflow_dispatch: {} # 수동 실행 (첫 시험용)

permissions:
  contents: read # 이 저장소 코드를 읽는 권한만. 쓰기 권한은 필요 없어요

concurrency:
  group: backup-db
  cancel-in-progress: false

jobs:
  backup:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: PostgreSQL 17 클라이언트 · age 설치
        # Supabase 서버 버전보다 같거나 높은 pg_dump가 필요해요 (낮으면 거부돼요)
        run: |
          set -euo pipefail
          sudo apt-get update -q
          sudo apt-get install -y -q curl ca-certificates gnupg age
          sudo install -d /usr/share/postgresql-common/pgdg
          sudo curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc
          echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt noble-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list > /dev/null
          sudo apt-get update -q
          sudo apt-get install -y -q postgresql-client-17
          pg_dump --version

      - name: 암호화 키 설정 확인 (2개 모두 있고 서로 달라야 해요)
        env:
          AGE_PUBLIC_KEY_1: ${{ secrets.AGE_PUBLIC_KEY_1 }}
          AGE_PUBLIC_KEY_2: ${{ secrets.AGE_PUBLIC_KEY_2 }}
        run: |
          set -euo pipefail
          # 키가 하나만 설정된 채로 백업이 만들어지면, 그 키를 잃을 때 전부 못 열어요 → 시작 전에 막아요
          case "$AGE_PUBLIC_KEY_1" in age1*) ;; *) echo "AGE_PUBLIC_KEY_1 이 올바르지 않아요"; exit 1;; esac
          case "$AGE_PUBLIC_KEY_2" in age1*) ;; *) echo "AGE_PUBLIC_KEY_2 가 올바르지 않아요"; exit 1;; esac
          test "$AGE_PUBLIC_KEY_1" != "$AGE_PUBLIC_KEY_2"

      - name: DB 내보내기 (public 전체 + 계정 데이터)
        env:
          SUPABASE_DB_URL: ${{ secrets.SUPABASE_DB_URL }}
        run: |
          set -euo pipefail
          umask 077
          # 접속 주소는 환경변수로만 쓰고, 로그에 값을 찍지 않아요 (set -x 금지)
          # 1) 앱 데이터: 표 구조 + 데이터 + 함수 · 트리거 · 보기(view)
          pg_dump "$SUPABASE_DB_URL" \
            --format=custom --no-owner --no-privileges \
            --schema=public \
            --file=public.dump
          # 2) 가입 계정: 이메일 · 비밀번호 해시 · 로그인 방식 정보만 (데이터만). 로그인 세션 · 토큰 · 감사 로그(IP)는 받지 않아요
          #    ※ -n(스키마)과 -t(표)를 같이 쓰면 -n이 무시되어서 덤프를 둘로 나눴어요
          pg_dump "$SUPABASE_DB_URL" \
            --format=custom --no-owner --no-privileges --data-only \
            --table=auth.users --table=auth.identities \
            --file=auth-users.dump

      - name: 내보낸 파일이 정상인지 확인 (내용은 출력하지 않아요)
        run: |
          set -euo pipefail
          test -s public.dump
          test -s auth-users.dump
          pub=$(pg_restore --list public.dump | wc -l)
          echo "public 목차 항목 수: ${pub}"
          test "${pub}" -gt 20
          # 계정 덤프에는 표 데이터 항목이 정확히 2개(users, identities)여야 해요
          auth=$(pg_restore --list auth-users.dump | grep -c "TABLE DATA" || true)
          echo "계정 덤프 표 데이터 항목 수: ${auth}"
          test "${auth}" -eq 2

      - name: 묶기 + 암호화 (age, 받는 사람 2명)
        env:
          AGE_PUBLIC_KEY_1: ${{ secrets.AGE_PUBLIC_KEY_1 }}
          AGE_PUBLIC_KEY_2: ${{ secrets.AGE_PUBLIC_KEY_2 }}
        run: |
          set -euo pipefail
          umask 077
          stamp=$(date -u +%Y%m%d-%H%M)
          tar -cf bundle.tar public.dump auth-users.dump
          age -r "$AGE_PUBLIC_KEY_1" -r "$AGE_PUBLIC_KEY_2" -o "bakery-db-${stamp}.tar.age" bundle.tar
          rm -f public.dump auth-users.dump bundle.tar # 암호화하지 않은 파일은 바로 지워요
          ls -l bakery-db-*.tar.age
          echo "ARTIFACT_FILE=bakery-db-${stamp}.tar.age" >> "$GITHUB_ENV"

      - name: 올리기 (GitHub 자동 만료 25일 설정 + 별도 삭제 작업이 21일 넘은 것을 삭제 시도)
        uses: actions/upload-artifact@v4
        with:
          name: bakery-db-backup
          path: ${{ env.ARTIFACT_FILE }}
          retention-days: 25 # ← 방침의 "25일 자동 만료"와 같은 값이에요. 바꾸면 방침 · cleanup-backups(21일) 도 함께 바꿔요
          if-no-files-found: error
